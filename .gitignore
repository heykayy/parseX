# Dependencies — never commit these, npm install recreates them
node_modules/

# Build output — generated by "npm run build"
dist/

# Environment files — contain secrets like API keys
.env
.env.local
.env.*.local

# Server env too
server/.env

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/settings.json
.idea/

# Vite cache
.vite/
