# ParseX Server — environment variables
# Copy this file to .env and fill in whichever keys you have
# You only need the key for the provider you are actively using
# NEVER commit .env to git

# ── AI Provider Keys ──────────────────────────────────────────────────────
# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_KEY=sk-ant-your-key-here

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_KEY=AIza-your-key-here

# OpenAI / GitHub Copilot (https://platform.openai.com/api-keys)
OPENAI_KEY=sk-your-key-here

# GitHub Copilot uses the OpenAI format at a different URL — uncomment if using Copilot
# OPENAI_BASE_URL=https://api.githubcopilot.com

# ── Server Config ─────────────────────────────────────────────────────────
# Port the server listens on (default: 3001)
PORT=3001

# Your deployed frontend URL — add this when you deploy to Vercel
# Example: FRONTEND_URL=https://parsex.vercel.app
FRONTEND_URL=
